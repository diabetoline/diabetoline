{
  "expo": {
    "name": "Diabetoline",
    "slug": "curalife",
    "version": "1.0.0",
    "scheme": "diabetoline",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.curalife.diabetoline",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan product barcodes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.curalife.diabetoline",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2C663A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Diabetoline uses the camera to scan barcodes, read nutrition labels and photograph your meals."
        }
      ],
      [
        "expo-localization",
        { "supportedLocales": { "ios": ["ro", "en", "de"], "android": ["ro", "en", "de"] } }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "curalife-development-srl",
    "extra": {
      "eas": {
        "projectId": "c16b0d89-5978-4d04-8189-6bd45744d1dc"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c16b0d89-5978-4d04-8189-6bd45744d1dc"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
